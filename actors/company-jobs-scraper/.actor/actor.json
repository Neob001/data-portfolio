{
  "actorSpecification": 1,
  "name": "company-jobs-scraper",
  "title": "Company Career Page Jobs Scraper (Greenhouse, Lever, Ashby)",
  "description": "Give it any company website - it finds the careers page, detects the ATS (Greenhouse, Lever, Ashby) and pulls every live job posting via official public job-board APIs. Flat records, pay per job. Working replacement, verified Sep 2026.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "dockerfile": "./Dockerfile",
  "outputSchema": "./output_schema.json",
  "categories": [
    "JOBS",
    "BUSINESS"
  ],
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "jobs": {
          "title": "Jobs",
          "transformation": {
            "fields": [
              "company",
              "title",
              "location",
              "department",
              "published_at",
              "job_url"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "found": {
            "type": "boolean"
          },
          "ats": {
            "type": [
              "string",
              "null"
            ]
          },
          "board": {
            "type": [
              "string",
              "null"
            ]
          },
          "company": {
            "type": [
              "string",
              "null"
            ]
          },
          "job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "department": {
            "type": [
              "string",
              "null"
            ]
          },
          "team": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "remote": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "employment_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "job_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "apply_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
