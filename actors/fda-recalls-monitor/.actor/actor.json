{
  "actorSpecification": 1,
  "name": "fda-recalls-monitor",
  "title": "FDA Recalls Scraper API \u2014 Food, Drug & Device Recalls",
  "description": "Search and monitor FDA recalls and enforcement reports for food, drugs and medical devices via official openFDA. Filter by keyword, Class I/II/III, date. No key, flat JSON, alerts. $3 per 1,000.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "dockerfile": "./Dockerfile",
  "outputSchema": "./output_schema.json",
  "categories": [
    "BUSINESS",
    "NEWS"
  ],
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "recalls": {
          "title": "Recalls",
          "transformation": {
            "fields": [
              "recall_initiation_date",
              "classification",
              "product_type",
              "recalling_firm",
              "reason_for_recall"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "recall_number": {
            "type": "string"
          },
          "event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "recalling_firm": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_for_recall": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_quantity": {
            "type": [
              "string",
              "null"
            ]
          },
          "distribution_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "voluntary_mandated": {
            "type": [
              "string",
              "null"
            ]
          },
          "recall_initiation_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "report_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
