{
  "actorSpecification": 1,
  "name": "lighthouse-auditor",
  "title": "Lighthouse & Core Web Vitals Checker API — Bulk PageSpeed",
  "description": "Run real Google Lighthouse audits in bulk: performance, SEO, accessibility and best-practices scores, LCP/CLS/TBT with pass/fail, and top fixes. Mobile and desktop. No API key or quota. $10 per 1,000 audits.",
  "version": "0.1",
  "buildTag": "latest",
  "minMemoryMbytes": 2048,
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "dockerfile": "./Dockerfile",
  "outputSchema": "./output_schema.json",
  "categories": [
    "SEO_TOOLS",
    "DEVELOPER_TOOLS"
  ],
  "storages": {
