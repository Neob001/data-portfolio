{
  "actorSpecification": 1,
  "name": "ofac-sanctions-screening",
  "title": "Sanctions Screening API — OFAC, EU, UK & UN Lists (AML/KYC)",
  "description": "Screen people, companies and vessels against the official OFAC SDN, EU, UK and UN Security Council sanctions lists, incl. aliases, with fuzzy match scores. Bulk AML/KYC checks. No API key. $3 per 1,000 names.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "dockerfile": "./Dockerfile",
  "outputSchema": "./output_schema.json",
  "categories": [
    "BUSINESS",
    "AUTOMATION"
  ],
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "screenings": {
          "title": "Screenings",
          "transformation": {
            "fields": [
              "query",
              "matched",
              "match_count",
              "best_score",
              "top_match_name",
              "lists_matched",
              "lists_screened",
              "lists_unavailable"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "match_count": {
            "type": "integer"
          },
          "top_match_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "top_match_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "best_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "lists_matched": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "list": {
                  "type": "string"
                },
                "list_entry_id": {
                  "type": "string"
                },
                "primary_name": {
                  "type": "string"
                },
                "matched_name": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "entity_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "programs": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "program_list": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "listed_on": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "uid": {
                  "type": "string"
                },
                "sdn_name": {
                  "type": "string"
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "list_publish_info": {
            "type": [
              "string",
              "null"
            ]
          },
          "lists_screened": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lists_unavailable": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lists_info": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "list": {
                  "type": "string"
                },
                "entries": {
                  "type": "integer"
                },
                "source_url": {
                  "type": "string"
                },
                "publication_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
