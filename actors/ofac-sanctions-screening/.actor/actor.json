{
  "actorSpecification": 1,
  "name": "ofac-sanctions-screening",
  "title": "OFAC Sanctions Screening API \u2014 SDN List Check for AML/KYC",
  "description": "Screen people and companies against the official US Treasury OFAC SDN sanctions list, incl. aliases, with fuzzy match scores. Bulk name lists for AML/KYC and vendor checks. No API key. $0.003 per name.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "dockerfile": "./Dockerfile",
  "outputSchema": "./output_schema.json",
  "categories": [
    "BUSINESS",
    "AUTOMATION"
  ],
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "screenings": {
          "title": "Screenings",
          "transformation": {
            "fields": [
              "query",
              "matched",
              "match_count",
              "top_match_name",
              "top_match_score"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "match_count": {
            "type": "integer"
          },
          "top_match_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "top_match_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "list_publish_info": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
