{
  "actorSpecification": 1,
  "name": "sam-gov-contracts",
  "title": "SAM.gov Contract Opportunities Scraper \u2014 Federal Bids API",
  "description": "US federal contract opportunities from the official SAM.gov data extract: solicitations, sources sought, awards. Filter by keyword, NAICS, set-aside, agency, state; daily new-bid alerts. No key. $2 per 1,000.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "dockerfile": "./Dockerfile",
  "outputSchema": "./output_schema.json",
  "categories": [
    "LEAD_GENERATION",
    "BUSINESS"
  ],
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "opportunities": {
          "title": "Opportunities",
          "transformation": {
            "fields": [
              "posted_date",
              "title",
              "department",
              "notice_type",
              "naics_code",
              "set_aside",
              "response_deadline",
              "notice_url"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
