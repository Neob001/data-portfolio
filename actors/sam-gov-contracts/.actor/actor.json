              "string",
              "null"
            ]
          },
          "posted_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "notice_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "base_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_deadline": {
            "type": [
              "string",
              "null"
            ]
          },
          "archive_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "set_aside_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "set_aside": {
            "type": [
              "string",
              "null"
            ]
          },
          "naics_code": {
            "type": [
              "string",
              "null"
            ]
          },
